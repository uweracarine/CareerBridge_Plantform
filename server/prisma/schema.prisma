// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Enum definitions
enum UserRole {
  student
  graduate
  job_seeker
  employer
  admin
  super_admin
}

enum AccountStatus {
  active
  inactive
  suspended
}

enum EmploymentType {
  full_time
  part_time
  internship
  contract
  freelance
  volunteer
}

enum WorkArrangement {
  remote
  onsite
  hybrid
}

enum ApplicationStatus {
  submitted
  under_review
  shortlisted
  interview_scheduled
  assessment
  accepted
  rejected
  withdrawn
}

enum OpportunityStatus {
  draft
  pending
  published
  closed
  rejected
  expired
}

enum VerificationStatus {
  pending
  verified
  rejected
}

enum OrganizationType {
  private
  ngo
  government
  startup
  university
  training
  international
}

enum DocumentType {
  registration
  tax_certificate
  business_license
  national_id
  passport
}

enum ReviewStatus {
  pending
  approved
  rejected
}

enum NotificationType {
  registration
  verification
  application
  message
  deadline
  opportunity
  admin
}

enum ResourceType {
  article
  video
  guide
  tool
  course
}

enum ReportReason {
  scam
  harassment
  inappropriate
  duplicate
  other
}

enum ReportStatus {
  pending
  reviewed
  resolved
}

enum ProficiencyLevel {
  beginner
  intermediate
  advanced
  expert
}

enum Currency {
  rwf
  usd
  eur
}

// Main User table
model User {
  id                String      @id @default(cuid())
  fullName          String      @db.VarChar(255)
  email             String      @unique @db.VarChar(255)
  passwordHash      String      @db.VarChar(255)
  phone             String?     @db.VarChar(20)
  role              UserRole    @default(student)
  profilePhoto      String?
  emailVerifiedAt   DateTime?
  accountStatus     AccountStatus @default(active)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  // Relations
  studentProfile    StudentProfile?
  organization      Organization?
  education         Education[]
  workExperience    WorkExperience[]
  userSkills        UserSkill[]
  certifications    Certification[]
  cvs               CV[]
  applications      Application[]
  savedOpportunities SavedOpportunity[]
  conversations     Conversation[]
  messages          Message[]
  notifications     Notification[]
  adminPermissions  AdminPermission[]
  reports           Report[]
  reportReviewedBy  Report[]       @relation(name: "ReportReviewedBy")
  activityLogs      ActivityLog[]
  approvedOpportunities Opportunity[] @relation("ApprovedBy")
  verifiedOrganizations Organization[] @relation("VerifiedBy")
  approvedDocuments OrganizationDocument[] @relation("ReviewedBy")
  statusChanges     ApplicationStatusHistory[] @relation("ChangedBy")
  publishedResources CareerResource[]

  @@index([email])
  @@index([role])
  @@index([accountStatus])
}

// Student Profile
model StudentProfile {
  id                String      @id @default(cuid())
  userId            String      @unique
  headline          String?     @db.VarChar(255)
  biography         String?     @db.Text
  dateOfBirth       DateTime?
  gender            String?     @db.VarChar(20)
  location          String?     @db.VarChar(255)
  linkedinUrl       String?
  githubUrl         String?
  portfolioUrl      String?
  profileCompletion Int         @default(0)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Education History
model Education {
  id                String      @id @default(cuid())
  userId            String
  institution       String      @db.VarChar(255)
  qualification     String      @db.VarChar(255)
  fieldOfStudy      String      @db.VarChar(255)
  startDate         DateTime
  endDate           DateTime?
  description       String?     @db.Text
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Work Experience
model WorkExperience {
  id                String      @id @default(cuid())
  userId            String
  organization      String      @db.VarChar(255)
  jobTitle          String      @db.VarChar(255)
  employmentType    EmploymentType
  startDate         DateTime
  endDate           DateTime?
  description       String?     @db.Text
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Skills
model Skill {
  id                String      @id @default(cuid())
  skillName         String      @unique @db.VarChar(255)
  category          String?     @db.VarChar(100)
  createdAt         DateTime    @default(now())

  userSkills        UserSkill[]

  @@index([skillName])
}

// User Skills (Junction table)
model UserSkill {
  id                String      @id @default(cuid())
  userId            String
  skillId           String
  proficiencyLevel  ProficiencyLevel @default(intermediate)
  createdAt         DateTime    @default(now())

  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill             Skill       @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@index([userId])
  @@index([skillId])
}

// Certifications
model Certification {
  id                String      @id @default(cuid())
  userId            String
  certificationName String      @db.VarChar(255)
  issuingOrg        String      @db.VarChar(255)
  issueDate         DateTime
  expiryDate        DateTime?
  certificateFile   String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// CVs
model CV {
  id                String      @id @default(cuid())
  userId            String
  fileName          String      @db.VarChar(255)
  filePath          String
  isDefault         Boolean     @default(false)
  uploadedAt        DateTime    @default(now())

  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications      Application[]

  @@index([userId])
  @@index([isDefault])
}

// Organizations
model Organization {
  id                String      @id @default(cuid())
  ownerUserId       String      @unique
  organizationName  String      @db.VarChar(255)
  organizationType  OrganizationType
  industry          String?     @db.VarChar(255)
  description       String?     @db.Text
  logo              String?
  website           String?     @db.VarChar(255)
  email             String      @db.VarChar(255)
  phone             String?     @db.VarChar(20)
  location          String      @db.VarChar(255)
  verificationStatus VerificationStatus @default(pending)
  verifiedAt        DateTime?
  verifiedById      String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  owner             User        @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  verifiedBy        User?       @relation("VerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  documents         OrganizationDocument[]
  opportunities     Opportunity[]
  conversations     Conversation[]

  @@index([ownerUserId])
  @@index([verificationStatus])
}

// Organization Documents
model OrganizationDocument {
  id                String      @id @default(cuid())
  organizationId    String
  documentType      DocumentType
  filePath          String
  reviewStatus      ReviewStatus @default(pending)
  reviewedById      String?
  reviewedAt        DateTime?
  createdAt         DateTime    @default(now())

  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reviewedBy        User?       @relation("ReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([reviewStatus])
}

// Categories
model Category {
  id                String      @id @default(cuid())
  categoryName      String      @unique @db.VarChar(255)
  description       String?     @db.Text
  createdAt         DateTime    @default(now())

  opportunities     Opportunity[]

  @@index([categoryName])
}

// Opportunities
model Opportunity {
  id                String      @id @default(cuid())
  organizationId    String
  categoryId        String
  title             String      @db.VarChar(255)
  slug              String      @unique @db.VarChar(255)
  description       String      @db.Text
  responsibilities  String      @db.Text
  qualifications    String      @db.Text
  requiredSkills    String?     @db.Text
  location          String      @db.VarChar(255)
  workArrangement   WorkArrangement
  employmentType    EmploymentType
  salaryMin         Decimal?    @db.Decimal(10, 2)
  salaryMax         Decimal?    @db.Decimal(10, 2)
  currency          Currency    @default(rwf)
  applicationUrl    String?
  applicationDeadline DateTime
  status            OpportunityStatus @default(draft)
  approvedById      String?
  approvedAt        DateTime?
  publishedAt       DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category          Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  approvedBy        User?        @relation("ApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  applications      Application[]
  savedBy           SavedOpportunity[]
  conversations     Conversation[]
  reports           Report[]

  @@index([organizationId])
  @@index([categoryId])
  @@index([status])
  @@index([applicationDeadline])
}

// Applications
model Application {
  id                String      @id @default(cuid())
  opportunityId     String
  applicantId       String
  cvId              String
  coverLetter       String?     @db.Text
  applicationStatus ApplicationStatus @default(submitted)
  submittedAt       DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  opportunity       Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  applicant         User        @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  cv                CV          @relation(fields: [cvId], references: [id], onDelete: Restrict)
  documents         ApplicationDocument[]
  statusHistory     ApplicationStatusHistory[]

  @@unique([opportunityId, applicantId])
  @@index([opportunityId])
  @@index([applicantId])
  @@index([applicationStatus])
  @@index([submittedAt])
}

// Application Documents
model ApplicationDocument {
  id                String      @id @default(cuid())
  applicationId     String
  documentName      String      @db.VarChar(255)
  filePath          String
  uploadedAt        DateTime    @default(now())

  application       Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

// Application Status History
model ApplicationStatusHistory {
  id                String      @id @default(cuid())
  applicationId     String
  oldStatus         ApplicationStatus
  newStatus         ApplicationStatus
  changedById       String
  notes             String?     @db.Text
  changedAt         DateTime    @default(now())

  application       Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  changedBy         User        @relation("ChangedBy", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([applicationId])
  @@index([changedById])
}

// Saved Opportunities
model SavedOpportunity {
  id                String      @id @default(cuid())
  userId            String
  opportunityId     String
  savedAt           DateTime    @default(now())

  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity       Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([userId, opportunityId])
  @@index([userId])
  @@index([opportunityId])
}

// Notifications
model Notification {
  id                String      @id @default(cuid())
  userId            String
  title             String      @db.VarChar(255)
  message           String      @db.Text
  notificationType  NotificationType
  isRead            Boolean     @default(false)
  createdAt         DateTime    @default(now())

  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

// Conversations
model Conversation {
  id                String      @id @default(cuid())
  opportunityId     String
  employerId        String
  applicantId       String
  createdAt         DateTime    @default(now())

  opportunity       Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  employer          Organization @relation(fields: [employerId], references: [id], onDelete: Cascade)
  applicant         User        @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  messages          Message[]

  @@unique([opportunityId, employerId, applicantId])
  @@index([opportunityId])
  @@index([employerId])
  @@index([applicantId])
}

// Messages
model Message {
  id                String      @id @default(cuid())
  conversationId    String
  senderId          String
  message           String      @db.Text
  readAt            DateTime?
  createdAt         DateTime    @default(now())

  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender            User        @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
}

// Career Resources
model CareerResource {
  id                String      @id @default(cuid())
  title             String      @db.VarChar(255)
  description       String      @db.Text
  content           String      @db.LongText
  resourceType      ResourceType
  thumbnail         String?
  publishedById     String
  status            String      @db.VarChar(50) @default("published")
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  publishedBy       User        @relation(fields: [publishedById], references: [id], onDelete: Cascade)

  @@index([publishedById])
  @@index([status])
}

// Reports
model Report {
  id                String      @id @default(cuid())
  reportedById      String
  opportunityId     String?
  reason            ReportReason
  description       String      @db.Text
  status            ReportStatus @default(pending)
  reviewedById      String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  reportedBy        User        @relation(fields: [reportedById], references: [id], onDelete: Cascade)
  opportunity       Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  reviewedBy        User?       @relation(name: "ReportReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([reportedById])
  @@index([status])
}

// Activity Logs
model ActivityLog {
  id                String      @id @default(cuid())
  userId            String?
  action            String      @db.VarChar(255)
  entityType        String      @db.VarChar(100)
  entityId          String      @db.VarChar(255)
  ipAddress         String?     @db.VarChar(45)
  createdAt         DateTime    @default(now())

  user              User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
}

// Admin Permissions
model AdminPermission {
  id                String      @id @default(cuid())
  adminUserId       String
  permissionName    String      @db.VarChar(255)
  createdAt         DateTime    @default(now())

  admin             User        @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@unique([adminUserId, permissionName])
  @@index([adminUserId])
}
